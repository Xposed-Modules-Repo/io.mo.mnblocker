<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Edge-to-edge base theme. No system ActionBar (every screen draws its own
        header), and both system bars are transparent so the page background shows
        through behind the status bar and the gesture pill. The insets are
        re-applied as padding by SystemBars.

        Every colour on screen comes from Palette at runtime (dynamic colour on
        Android 12+); this theme only has to get the first frame and the platform
        widgets (dialogs, popups) onto the right side of light / dark. The dark
        twin lives in values-night.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Light background => the clock and the gesture pill must be drawn dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
